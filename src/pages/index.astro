---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/ContactPage.astro';
---
<BaseLayout title="Testlets | VemMED" description="Revise com questões relacionadas, perceba como os conteúdos se conectam e avance nos estudos com mais foco.">
  <main id="conteudo">
    <section class="hero" aria-labelledby="hero-title">
      <span class="decoration-circle" aria-hidden="true"></span>
      <span class="decoration-diamond" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__copy">
          <a class="wordmark" href="#conteudo" aria-label="VemMED, início">
            <img src="/assets/logo-vemmed.svg" alt="VemMED" />
          </a>
          <p class="page-badge">TESTLETS</p>
          <h1 id="hero-title">Testlets</h1>
          <p class="hero__lead">O ENEM está mudando, e sua preparação pode acompanhar essa mudança com tranquilidade. Conheça os testlets e pratique o formato que o Inep passou a incorporar às provas.</p>
          <div class="hero__access" role="note" aria-label="Acesso gratuito">
            <span class="hero__access-check" aria-hidden="true">✓</span>
            <div>
              <p class="hero__access-title">Acesso gratuito.</p>
              <p class="hero__access-description">Solicite a liberação pelo formulário.</p>
            </div>
          </div>
        </div>
        <aside class="capture-panel" id="cadastro" aria-labelledby="panel-title">
          <p class="capture-panel__eyebrow">ACESSO AO APLICATIVO</p>
          <p class="capture-panel__description" id="panel-title">Solicite acesso aos Testlets e comece a praticar.</p>
          <ContactPage />
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
